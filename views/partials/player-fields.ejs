<div class="row2">
  <label>Imię <input name="first_name" value="<%= player.first_name || '' %>" required maxlength="80"></label>
  <label>Nazwisko <input name="last_name" value="<%= player.last_name || '' %>" required maxlength="80"></label>
</div>
<div class="row2">
  <label>Data urodzenia <input type="date" name="birth_date" value="<%= player.birth_date || '' %>"></label>
  <label>Ręka
    <select name="dominant_hand">
      <option value="">—</option>
      <option value="right" <%= player.dominant_hand === 'right' ? 'selected' : '' %>>Praworęczny</option>
      <option value="left" <%= player.dominant_hand === 'left' ? 'selected' : '' %>>Leworęczny</option>
    </select>
  </label>
</div>
<label>Poziom / grupa <input name="level" value="<%= player.level || '' %>" placeholder="np. Red, Orange, Green, Yellow" maxlength="60"></label>
<label>Uwagi (widoczne dla rodziców) <textarea name="notes" rows="3" maxlength="4000"><%= player.notes || '' %></textarea></label>
<label>Notatki prywatne trenera (niewidoczne dla rodziców) <textarea name="private_notes" rows="3" maxlength="4000"><%= player.private_notes || '' %></textarea></label>
