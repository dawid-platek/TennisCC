<%- include('partials/header') %>
<% const hidden = '<input type="hidden" name="_csrf" value="' + csrfToken + '">'; %>
<p><a href="<%= isCoach ? '/players' : '/my' %>">← <%= isCoach ? 'Wszyscy zawodnicy' : 'Moje dzieci' %></a></p>

<section class="card hero">
  <span class="avatar big"><%= player.first_name[0] %><%= player.last_name[0] %></span>
  <div class="grow">
    <h1><%= player.first_name %> <%= player.last_name %></h1>
    <div class="muted">
      <%= player.age != null ? player.age + ' lat' : '' %>
      <% if (player.birth_date) { %>(ur. <%= formatDate(player.birth_date) %>)<% } %>
      <% if (player.level) { %> · Poziom: <strong><%= player.level %></strong><% } %>
      <% if (player.dominant_hand) { %> · <%= player.dominant_hand === 'left' ? 'Leworęczny' : 'Praworęczny' %><% } %>
    </div>
  </div>
  <% if (isCoach) { %><a class="btn" href="/players/<%= player.id %>/edit">Edytuj</a><% } %>
</section>

<div class="stats">
  <div class="stat"><span class="num"><%= latest && latest.avg != null ? latest.avg.toFixed(1) : '–' %></span><span class="lbl">Średnia ocena</span></div>
  <div class="stat"><span class="num"><%= stats.trainings %></span><span class="lbl">Treningi</span></div>
  <div class="stat"><span class="num"><%= stats.wins %>–<%= stats.losses %></span><span class="lbl">Mecze W–P</span></div>
  <div class="stat"><span class="num"><%= goals.filter(g => g.done).length %>/<%= goals.length %></span><span class="lbl">Cele osiągnięte</span></div>
</div>

<% if (player.notes || (isCoach && player.private_notes)) { %>
<section class="card">
  <% if (player.notes) { %><h2>Uwagi trenera</h2><p class="pre"><%= player.notes %></p><% } %>
  <% if (isCoach && player.private_notes) { %>
    <h2>Notatki prywatne <span class="badge">tylko trener</span></h2><p class="pre"><%= player.private_notes %></p>
  <% } %>
</section>
<% } %>

<section class="card" id="oceny">
  <h2>Umiejętności</h2>
  <% if (!latest) { %>
    <p class="muted">Brak ocen umiejętności.</p>
  <% } else { %>
    <p class="muted small">Ostatnia ocena: <%= formatDate(latest.date) %><% if (previous) { %> · porównanie z <%= formatDate(previous.date) %><% } %></p>
    <div class="skills">
      <% skills.forEach(([key, label]) => { const v = latest[key]; const pv = previous ? previous[key] : null; %>
        <div class="skill">
          <span class="skill-name"><%= label %></span>
          <span class="bar"><span style="width: <%= (v || 0) * 10 %>%"></span></span>
          <span class="skill-val"><%= v == null ? '–' : v %>
            <% if (v != null && pv != null && v !== pv) { %>
              <span class="delta <%= v > pv ? 'up' : 'down' %>"><%= v > pv ? '▲' : '▼' %><%= Math.abs(v - pv) %></span>
            <% } %>
          </span>
        </div>
      <% }) %>
    </div>
    <% if (latest.comment) { %><p class="pre comment"><%= latest.comment %></p><% } %>
  <% } %>

  <% if (chart) { %>
    <h3>Średnia ocena w czasie</h3>
    <%- chart %>
  <% } %>

  <% if (assessments.length) { %>
  <details>
    <summary>Historia ocen (<%= assessments.length %>)</summary>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Data</th><% skills.forEach(([, label]) => { %><th><%= label %></th><% }) %><th>Śr.</th><th></th></tr></thead>
      <tbody>
      <% assessments.forEach(a => { %>
        <tr>
          <td><%= formatDate(a.date) %></td>
          <% skills.forEach(([key]) => { %><td><%= a[key] == null ? '–' : a[key] %></td><% }) %>
          <td><strong><%= a.avg == null ? '–' : a.avg.toFixed(1) %></strong></td>
          <td><%- include('partials/delete', { kind: 'assessments', id: a.id }) %></td>
        </tr>
        <% if (a.comment) { %><tr class="sub"><td colspan="<%= skills.length + 3 %>"><%= a.comment %></td></tr><% } %>
      <% }) %>
      </tbody>
    </table>
    </div>
  </details>
  <% } %>

  <% if (isCoach) { %>
  <details class="add">
    <summary>+ Nowa ocena umiejętności</summary>
    <form method="post" action="/players/<%= player.id %>/assessments" class="stack">
      <%- hidden %>
      <label>Data <input type="date" name="date" value="<%= today %>" required></label>
      <div class="score-grid">
        <% skills.forEach(([key, label]) => { %>
          <label><%= label %> <input type="number" name="<%= key %>" min="1" max="10" value="<%= latest && latest[key] != null ? latest[key] : '' %>"></label>
        <% }) %>
      </div>
      <p class="muted small">Skala 1–10. Pola wstępnie wypełnione ostatnią oceną; puste pole = brak oceny.</p>
      <label>Komentarz <textarea name="comment" rows="2" maxlength="2000"></textarea></label>
      <button class="btn primary">Zapisz ocenę</button>
    </form>
  </details>
  <% } %>
</section>

<div class="columns even">
<section class="card" id="cele">
  <h2>Cele</h2>
  <% if (!goals.length) { %><p class="muted">Brak celów.</p><% } %>
  <ul class="list">
    <% goals.forEach(g => { %>
      <li class="<%= g.done ? 'done' : '' %>">
        <% if (isCoach) { %>
          <form method="post" action="/players/<%= player.id %>/goals/<%= g.id %>/toggle" class="inline">
            <%- hidden %><button class="check-btn" title="Oznacz jako <%= g.done ? 'nieosiągnięty' : 'osiągnięty' %>"><%= g.done ? '✓' : '' %></button>
          </form>
        <% } else { %>
          <span class="check-btn"><%= g.done ? '✓' : '' %></span>
        <% } %>
        <span class="grow"><%= g.title %><% if (g.target_date) { %> <span class="muted small">do <%= formatDate(g.target_date) %></span><% } %></span>
        <%- include('partials/delete', { kind: 'goals', id: g.id }) %>
      </li>
    <% }) %>
  </ul>
  <% if (isCoach) { %>
  <details class="add">
    <summary>+ Nowy cel</summary>
    <form method="post" action="/players/<%= player.id %>/goals" class="stack">
      <%- hidden %>
      <label>Cel <input name="title" required maxlength="300" placeholder="np. 70% pierwszego serwisu w korcie"></label>
      <label>Termin <input type="date" name="target_date"></label>
      <button class="btn primary">Dodaj cel</button>
    </form>
  </details>
  <% } %>
</section>

<section class="card" id="mecze">
  <h2>Mecze i turnieje</h2>
  <% if (!matches.length) { %><p class="muted">Brak meczów.</p><% } %>
  <ul class="list">
    <% matches.forEach(m => { %>
      <li>
        <span class="result <%= m.result %>"><%= m.result === 'W' ? 'W' : 'P' %></span>
        <span class="grow">
          <%= m.opponent ? 'vs ' + m.opponent : 'Mecz' %> <% if (m.score) { %><strong><%= m.score %></strong><% } %>
          <span class="muted small block"><%= formatDate(m.date) %><% if (m.tournament) { %> · <%= m.tournament %><% } %></span>
          <% if (m.notes) { %><span class="small block pre"><%= m.notes %></span><% } %>
        </span>
        <%- include('partials/delete', { kind: 'matches', id: m.id }) %>
      </li>
    <% }) %>
  </ul>
  <% if (isCoach) { %>
  <details class="add">
    <summary>+ Nowy mecz</summary>
    <form method="post" action="/players/<%= player.id %>/matches" class="stack">
      <%- hidden %>
      <div class="row2">
        <label>Data <input type="date" name="date" value="<%= today %>" required></label>
        <label>Wynik
          <select name="result" required><option value="W">Wygrana</option><option value="L">Przegrana</option></select>
        </label>
      </div>
      <label>Turniej <input name="tournament" maxlength="200"></label>
      <div class="row2">
        <label>Przeciwnik <input name="opponent" maxlength="200"></label>
        <label>Wynik w setach <input name="score" maxlength="60" placeholder="6:4 3:6 10:8"></label>
      </div>
      <label>Uwagi <textarea name="notes" rows="2" maxlength="2000"></textarea></label>
      <button class="btn primary">Dodaj mecz</button>
    </form>
  </details>
  <% } %>
</section>
</div>

<section class="card" id="treningi">
  <h2>Dziennik treningów</h2>
  <% if (!trainings.length) { %><p class="muted">Brak wpisów.</p><% } %>
  <ul class="list">
    <% trainings.forEach(t => { %>
      <li>
        <span class="date-pill"><%= formatDate(t.date) %></span>
        <span class="grow">
          <strong><%= t.topic %></strong><% if (t.duration_min) { %> <span class="muted small">· <%= t.duration_min %> min</span><% } %>
          <% if (t.notes) { %><span class="small block pre"><%= t.notes %></span><% } %>
        </span>
        <%- include('partials/delete', { kind: 'trainings', id: t.id }) %>
      </li>
    <% }) %>
  </ul>
  <% if (isCoach) { %>
  <details class="add">
    <summary>+ Nowy trening</summary>
    <form method="post" action="/players/<%= player.id %>/trainings" class="stack">
      <%- hidden %>
      <div class="row2">
        <label>Data <input type="date" name="date" value="<%= today %>" required></label>
        <label>Czas (min) <input type="number" name="duration_min" min="1" max="600" value="60"></label>
      </div>
      <label>Temat <input name="topic" required maxlength="200" placeholder="np. Serwis – rzut piłki, trafienie w pole"></label>
      <label>Notatki <textarea name="notes" rows="2" maxlength="2000"></textarea></label>
      <button class="btn primary">Dodaj trening</button>
    </form>
  </details>
  <% } %>
</section>

<% if (isCoach) { %>
<section class="card" id="rodzice">
  <h2>Rodzice z dostępem <span class="badge">tylko trener</span></h2>
  <p class="muted small">Tylko te osoby (oraz trenerzy) widzą profil tego zawodnika.</p>
  <ul class="list">
    <% if (!parents.length) { %><li class="muted">Nikt nie ma jeszcze dostępu.</li><% } %>
    <% parents.forEach(pr => { %>
      <li>
        <span class="grow"><strong><%= pr.name %></strong> <span class="muted small"><%= pr.email %></span></span>
        <form method="post" action="/players/<%= player.id %>/parents/<%= pr.id %>/remove" class="inline" data-confirm="Odebrać dostęp: <%= pr.name %>?">
          <%- hidden %><button class="btn small">Odłącz</button>
        </form>
      </li>
    <% }) %>
  </ul>
  <% const available = allParents.filter(a => !parents.some(p => p.id === a.id)); %>
  <% if (available.length) { %>
    <form method="post" action="/players/<%= player.id %>/parents" class="row-form">
      <%- hidden %>
      <select name="parent_id" required>
        <option value="">Wybierz rodzica…</option>
        <% available.forEach(a => { %><option value="<%= a.id %>"><%= a.name %> (<%= a.email %>)</option><% }) %>
      </select>
      <button class="btn">Przypisz</button>
    </form>
  <% } %>
  <p class="small"><a href="/parents">Utwórz nowe konto rodzica →</a></p>
</section>
<% } %>
<%- include('partials/footer') %>
