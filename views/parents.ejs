<%- include('partials/header') %>
<div class="page-head"><h1>Konta rodziców <span class="muted">(<%= parents.length %>)</span></h1></div>
<div class="columns">
  <div>
    <% if (!parents.length) { %>
      <section class="card"><p>Brak kont rodziców. Utwórz konto i przypisz do niego dziecko — rodzic zobaczy tylko swoje dzieci.</p></section>
    <% } %>
    <% parents.forEach(p => { %>
      <section class="card parent">
        <div class="parent-head">
          <div>
            <strong><%= p.name %></strong>
            <div class="muted small"><%= p.email %><% if (p.phone) { %> · <%= p.phone %><% } %></div>
          </div>
          <div class="actions">
            <form method="post" action="/parents/<%= p.id %>/reset-password" data-confirm="Wygenerować nowe hasło tymczasowe dla <%= p.name %>?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn small">Resetuj hasło</button>
            </form>
            <form method="post" action="/parents/<%= p.id %>/delete" data-confirm="Usunąć konto rodzica <%= p.name %>? Dane dzieci pozostaną.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn small danger">Usuń</button>
            </form>
          </div>
        </div>
        <div class="chips">
          <% if (!p.children.length) { %><span class="muted small">Brak przypisanych dzieci</span><% } %>
          <% p.children.forEach(c => { %><a class="chip" href="/players/<%= c.id %>"><%= c.first_name %> <%= c.last_name %></a><% }) %>
        </div>
      </section>
    <% }) %>
  </div>
  <aside class="card">
    <h2>Nowe konto rodzica</h2>
    <form method="post" action="/parents" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Imię i nazwisko <input name="name" required maxlength="100"></label>
      <label>E-mail (login) <input type="email" name="email" required maxlength="200" autocomplete="off"></label>
      <label>Telefon <input name="phone" maxlength="40"></label>
      <label>Hasło <input type="text" name="password" minlength="<%= minPassword %>" placeholder="puste = wygeneruj automatycznie" autocomplete="off"></label>
      <% if (players.length) { %>
        <fieldset>
          <legend>Dzieci</legend>
          <div class="checklist">
          <% players.forEach(pl => { %>
            <label class="check"><input type="checkbox" name="player_ids" value="<%= pl.id %>"> <%= pl.first_name %> <%= pl.last_name %></label>
          <% }) %>
          </div>
        </fieldset>
      <% } %>
      <button class="btn primary">Utwórz konto</button>
    </form>
  </aside>
</div>
<%- include('partials/footer') %>
