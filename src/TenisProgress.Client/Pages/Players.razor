@page "/players"
@attribute [Authorize(Roles = Roles.Coach)]
@inject Api Api
@inject Toasts Toasts
@inject NavigationManager Nav

<PageTitle>Zawodnicy · Tenis Progress</PageTitle>

<div class="page-head">
    <div>
        <h1>Zawodnicy</h1>
        @if (_players is not null) { <p class="muted">@_players.Count @(_players.Count == 1 ? "zawodnik" : "zawodników")</p> }
    </div>
    <button class="btn primary" @onclick="() => _showAdd = !_showAdd">
        <Icon Name="@(_showAdd ? "x" : "plus")" Size="18" /> @(_showAdd ? "Zamknij" : "Dodaj zawodnika")
    </button>
</div>

@if (_showAdd)
{
    <section class="card panel">
        <h2><Icon Name="plus" /> Nowy zawodnik</h2>
        <ErrorList Errors="_errors" />
        <EditForm Model="_form" OnValidSubmit="AddAsync" class="stack" FormName="add-player">
            <DataAnnotationsValidator />
            <PlayerFields Model="_form" />
            <div><button class="btn primary">Dodaj zawodnika</button></div>
        </EditForm>
    </section>
}

@if (_players is null)
{
    <ErrorList Errors="_loadErrors" />
    @if (_loadErrors is null) { <p class="muted loading">Ładowanie…</p> }
}
else if (_players.Count == 0)
{
    <section class="card empty-state">
        <Icon Name="users" Size="32" />
        <p>Nie masz jeszcze żadnych zawodników.<br />Dodaj pierwszego przyciskiem powyżej.</p>
    </section>
}
else
{
    <div class="search-wrap">
        <Icon Name="search" Size="18" />
        <input class="search" type="search" placeholder="Szukaj zawodnika…" @bind="_query" @bind:event="oninput" />
    </div>
    <div class="grid">
        @foreach (var p in Filtered)
        {
            <PlayerCard Player="p" />
        }
    </div>
}

@code {
    private List<PlayerSummary>? _players;
    private IReadOnlyList<string>? _loadErrors, _errors;
    private PlayerForm _form = new();
    private string _query = "";
    private bool _showAdd;

    private IEnumerable<PlayerSummary> Filtered => _players!.Where(p =>
        _query.Length == 0 || p.FullName.Contains(_query, StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.Players();
        if (res.Ok) _players = res.Value; else _loadErrors = res.Errors;
    }

    private async Task AddAsync()
    {
        var res = await Api.CreatePlayer(_form);
        if (!res.Ok)
        {
            _errors = res.Errors;
            return;
        }
        Toasts.Success($"Dodano zawodnika: {_form.FirstName} {_form.LastName}.", $"players/{res.Value!.Id}");
        Nav.NavigateTo($"players/{res.Value!.Id}");
    }
}
