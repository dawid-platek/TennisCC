@page "/parents"
@attribute [Authorize(Roles = Roles.Coach)]
@inject Api Api
@inject Toasts Toasts
@inject IJSRuntime Js

<PageTitle>Rodzice · Tenis Progress</PageTitle>

<div class="page-head">
    <div>
        <h1>Rodzice</h1>
        @if (_parents is not null) { <p class="muted">@_parents.Count @Plural(_parents.Count)</p> }
    </div>
    <button class="btn primary" @onclick="() => _showAdd = !_showAdd">
        <Icon Name="@(_showAdd ? "x" : "plus")" Size="18" /> @(_showAdd ? "Zamknij" : "Nowe konto")
    </button>
</div>

@if (_showAdd)
{
    <section class="card panel">
        <h2><Icon Name="plus" /> Nowe konto rodzica</h2>
        <ErrorList Errors="_errors" />
        <EditForm Model="_form" OnValidSubmit="CreateAsync" class="stack" FormName="parent">
            <DataAnnotationsValidator />
            <div class="row2">
                <label>Imię i nazwisko <InputText @bind-Value="_form.Name" maxlength="100" /></label>
                <label>E-mail (login) <InputText type="email" @bind-Value="_form.Email" maxlength="200" autocomplete="off" /></label>
            </div>
            <ValidationMessage For="() => _form.Name" />
            <ValidationMessage For="() => _form.Email" />
            <div class="row2">
                <label>Telefon <InputText type="tel" @bind-Value="_form.Phone" maxlength="40" /></label>
                <label>Hasło <InputText @bind-Value="_form.Password" placeholder="puste = wygeneruj automatycznie" autocomplete="off" /></label>
            </div>
            @if (_players is { Count: > 0 })
            {
                <fieldset>
                    <legend>Dzieci tego rodzica</legend>
                    <div class="checklist">
                        @foreach (var pl in _players)
                        {
                            <label class="check">
                                <input type="checkbox" checked="@_form.PlayerIds.Contains(pl.Id)" @onchange="e => TogglePlayer(pl.Id, e)" />
                                @pl.FullName
                            </label>
                        }
                    </div>
                </fieldset>
            }
            <div><button class="btn primary">Utwórz konto</button></div>
        </EditForm>
    </section>
}

<ErrorList Errors="_loadErrors" />
@if (_parents is { Count: 0 })
{
    <section class="card empty-state">
        <Icon Name="heart" Size="32" />
        <p>Brak kont rodziców.<br />Utwórz konto i przypisz do niego dziecko — rodzic zobaczy tylko swoje dzieci.</p>
    </section>
}
<div class="grid wide">
    @foreach (var p in _parents ?? [])
    {
        <section class="card parent">
            <div class="parent-head">
                <span class="avatar">@Initials(p.Name)</span>
                <div class="grow">
                    <strong>@p.Name</strong>
                    <div class="muted small">@p.Email@(p.Phone is null ? "" : $" · {p.Phone}")</div>
                </div>
            </div>
            <div class="chips">
                @if (p.Children.Count == 0) { <span class="muted small">Brak przypisanych dzieci</span> }
                @foreach (var c in p.Children) { <a class="chip" href="players/@c.Id">@c.FullName</a> }
            </div>
            <div class="actions">
                <button class="btn small" @onclick="() => ResetAsync(p)"><Icon Name="key" Size="16" /> Resetuj hasło</button>
                <button class="btn small danger" @onclick="() => DeleteAsync(p)"><Icon Name="trash" Size="16" /> Usuń</button>
            </div>
        </section>
    }
</div>

@code {
    private List<ParentDto>? _parents;
    private List<PlayerSummary>? _players;
    private IReadOnlyList<string>? _loadErrors, _errors;
    private ParentForm _form = new();
    private bool _showAdd;

    // Polish plural of "konto": 1 konto, 2–4 konta, 5+ kont.
    private static string Plural(int n) =>
        n == 1 ? "konto" : n % 10 is >= 2 and <= 4 && n % 100 is < 12 or > 14 ? "konta" : "kont";

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    protected override async Task OnInitializedAsync()
    {
        _players = (await Api.Players()).Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var res = await Api.Parents();
        _parents = res.Value;
        _loadErrors = res.Ok ? null : res.Errors;
    }

    private void TogglePlayer(int id, ChangeEventArgs e)
    {
        if (e.Value is true) _form.PlayerIds.Add(id); else _form.PlayerIds.Remove(id);
    }

    private async Task CreateAsync()
    {
        var res = await Api.CreateParent(_form);
        if (!res.Ok)
        {
            _errors = res.Errors;
            return;
        }
        _errors = null;
        var c = res.Value!;
        // The temporary password is shown once and stays until dismissed.
        Toasts.Success(c.TemporaryPassword is { } pwd
            ? $"Utworzono konto dla {_form.Name}. Login: {c.Email}, hasło tymczasowe: {pwd} — przekaż je rodzicowi (pokazujemy je tylko raz)."
            : $"Utworzono konto dla {_form.Name} (login: {c.Email}).", sticky: c.TemporaryPassword is not null);
        _form = new();
        _showAdd = false;
        await LoadAsync();
    }

    private async Task ResetAsync(ParentDto p)
    {
        if (!await Js.ConfirmAsync($"Wygenerować nowe hasło tymczasowe dla {p.Name}? Rodzic zostanie wylogowany ze wszystkich urządzeń.")) return;
        var res = await Api.ResetParentPassword(p.Id);
        if (res.Ok) Toasts.Success($"Nowe hasło tymczasowe dla {p.Name} ({p.Email}): {res.Value!.TemporaryPassword}", sticky: true);
        else Toasts.Errors(res.Errors);
    }

    private async Task DeleteAsync(ParentDto p)
    {
        if (!await Js.ConfirmAsync($"Usunąć konto rodzica {p.Name}? Dane dzieci pozostaną.")) return;
        var res = await Api.DeleteParent(p.Id);
        if (res.Ok) Toasts.Success($"Usunięto konto rodzica: {p.Name}."); else Toasts.Errors(res.Errors);
        await LoadAsync();
    }
}
