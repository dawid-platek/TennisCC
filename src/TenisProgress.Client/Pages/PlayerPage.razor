@page "/players/{Id:int}"
@attribute [Authorize]
@inject Api Api
@inject AppAuthStateProvider Auth
@inject Toasts Toasts
@inject IJSRuntime Js

<PageTitle>@(_p?.FullName ?? "Zawodnik") · Tenis Progress</PageTitle>

<a class="back" href="@(IsCoach ? "players" : "my")"><Icon Name="chevron-left" Size="18" /> @(IsCoach ? "Wszyscy zawodnicy" : "Moje dzieci")</a>
<ErrorList Errors="_loadErrors" />

@if (_p is { } p)
{
    // Trainings come newest first; the "current" level is the most recent rated training.
    var rated = p.Trainings.Where(t => t.HasScores).ToList();
    var latest = rated.FirstOrDefault();
    var wins = p.Matches.Count(m => m.Won);

    <section class="card hero">
        <span class="avatar big">@p.Initials</span>
        <div class="grow">
            <h1>@p.FullName</h1>
            <div class="muted">
                @if (p.Age is { } age) { <text>@age lat </text> }
                @if (p.BirthDate is { } bd) { <text>(ur. @bd.ToString("dd.MM.yyyy"))</text> }
                @if (p.Level is { } level) { <text> · Poziom: <strong>@level</strong></text> }
                @if (p.DominantHand is { } hand) { <text> · @(hand == Hand.Left ? "Leworęczny" : "Praworęczny")</text> }
            </div>
        </div>
        @if (IsCoach) { <a class="btn ghost" href="players/@p.Id/edit"><Icon Name="pencil" Size="16" /> Edytuj</a> }
    </section>

    <div class="stats">
        <div class="stat"><span class="num">@(Skills.LatestAverage(rated.Select(t => t.Scores))?.ToString("0.0") ?? "–")</span><span class="lbl">Średnia (1–6)</span></div>
        <div class="stat"><span class="num">@p.Trainings.Count</span><span class="lbl">Treningi</span></div>
        <div class="stat"><span class="num">@wins–@(p.Matches.Count - wins)</span><span class="lbl">Mecze W–P</span></div>
        <div class="stat"><span class="num">@p.Goals.Count(g => g.Done)/@p.Goals.Count</span><span class="lbl">Cele osiągnięte</span></div>
    </div>

    @if (p.Notes is not null || p.PrivateNotes is not null)
    {
        <section class="card">
            @if (p.Notes is not null)
            {
                <h2><Icon Name="file" /> Uwagi trenera</h2>
                <p class="pre">@p.Notes</p>
            }
            @if (p.PrivateNotes is not null)
            {
                <h2><Icon Name="lock" /> Notatki prywatne <span class="badge">tylko trener</span></h2>
                <p class="pre">@p.PrivateNotes</p>
            }
        </section>
    }

    <section class="card" id="postepy">
        <h2><Icon Name="trending-up" /> Postęp w czasie</h2>
        @if (latest is null)
        {
            <p class="muted">Brak ocen. Oceny (1–6) wpisuje trener w dzienniku treningów.</p>
        }
        else
        {
            <div class="chart-head">
                <div>
                    <div class="chart-title">Postęp zagrań</div>
                    <p class="muted small">Ocena 1–@Skills.Max po każdym treningu (@Skills.Max = najlepiej)</p>
                </div>
                <div class="pills" role="group" aria-label="Wybór elementów na wykresie">
                    <button class="pill @(_focus is null ? "active" : "")" @onclick="() => _focus = null">Wszystkie</button>
                    @foreach (var skill in Skills.All)
                    {
                        <button class="pill k-@skill.Key @(_focus == skill.Key ? "active" : "")" @onclick="() => _focus = skill.Key">
                            <span class="dot"></span>@skill.Label
                        </button>
                    }
                </div>
            </div>
            @if (rated.Count >= 2)
            {
                <SkillChart Trainings="p.Trainings" Only="FocusSkills" Label="Wykres postępów w czasie" />
            }
            else
            {
                <p class="muted small">Wykres pojawi się po drugiej ocenionej sesji treningowej.</p>
            }

            <h3>Średnie ocen z całego okresu</h3>
            <div class="avg-cards">
                @foreach (var skill in Skills.All)
                {
                    var (avg, delta) = Stats(p.Trainings, skill.Key);
                    <div class="avg-card k-@skill.Key">
                        <div class="avg-head">
                            <span class="avg-name"><span class="dot"></span>@skill.Label</span>
                            <span class="avg-val">@(avg?.ToString("0.0") ?? "–")</span>
                        </div>
                        <div class="avg-bar"><span style="width: @((int)Math.Round((avg ?? 0) / Skills.Max * 100))%"></span></div>
                        @if (delta is { } dlt)
                        {
                            <div class="avg-trend @(dlt > 0 ? "up" : dlt < 0 ? "down" : "")">
                                <Icon Name="@(dlt > 0 ? "trending-up" : dlt < 0 ? "trending-down" : "minus")" Size="16" />
                                @(dlt > 0 ? $"+{dlt}" : dlt < 0 ? $"−{-dlt}" : "bez zmian") od pierwszego treningu
                            </div>
                        }
                        else
                        {
                            <div class="avg-trend">Za mało ocen, by pokazać trend</div>
                        }
                    </div>
                }
            </div>

            <h3>Każdy element osobno</h3>
            <div class="skill-cards">
                @foreach (var skill in Skills.All)
                {
                    // Newest first: the element's latest rating and the one before it.
                    var history = rated.Select(t => t.Scores.GetValueOrDefault(skill.Key)).Where(x => x.HasValue).ToList();
                    var v = history.FirstOrDefault();
                    var pv = history.Skip(1).FirstOrDefault();
                    <div class="skill-card k-@skill.Key">
                        <div class="sc-head">
                            <span class="sc-name">@skill.Label</span>
                            <span class="sc-val">
                                @(v?.ToString() ?? "–")<span class="sc-max">/@Skills.Max</span>
                                @if (v is { } cur && pv is { } prev && cur != prev)
                                {
                                    <span class="delta @(cur > prev ? "up" : "down")">@(cur > prev ? "▲" : "▼")@Math.Abs(cur - prev)</span>
                                }
                            </span>
                        </div>
                        <SkillChart Trainings="p.Trainings" Only="new[] { skill }" Compact="true" Label="@($"Wykres postępów: {skill.Label}")" />
                    </div>
                }
            </div>
        }
    </section>

    <div class="columns even">
        <section class="card">
            <h2><Icon Name="target" /> Cele</h2>
            @if (p.Goals.Count == 0) { <p class="muted">Brak celów.</p> }
            <ul class="list">
                @foreach (var g in p.Goals)
                {
                    <li class="@(g.Done ? "done" : "")">
                        @if (IsCoach)
                        {
                            <button class="check-btn" title="@(g.Done ? "Oznacz jako nieosiągnięty" : "Oznacz jako osiągnięty")"
                                    @onclick="() => ToggleGoalAsync(g.Id)">@(g.Done ? "✓" : "")</button>
                        }
                        else
                        {
                            <span class="check-btn">@(g.Done ? "✓" : "")</span>
                        }
                        <span class="grow">
                            @g.Title
                            @if (g.TargetDate is { } td) { <span class="muted small"> do @td.ToString("dd.MM.yyyy")</span> }
                        </span>
                        @if (IsCoach) { <button class="icon-btn" aria-label="Usuń cel" @onclick="() => DeleteAsync(Kind.Goals, g.Id)"><Icon Name="x" Size="18" /></button> }
                    </li>
                }
            </ul>
            @if (IsCoach)
            {
                <AddSection Title="Nowy cel" @bind-Open="_open[Kind.Goals]">
                    <EditForm Model="_goal" OnValidSubmit="() => AddAsync(Kind.Goals, _goal)" class="stack" FormName="goal">
                        <DataAnnotationsValidator />
                        <label>Cel <InputText @bind-Value="_goal.Title" maxlength="300" placeholder="np. 70% pierwszego serwisu w korcie" /></label>
                        <ValidationMessage For="() => _goal.Title" />
                        <label>Termin <InputDate @bind-Value="_goal.TargetDate" /></label>
                        <button class="btn primary">Dodaj cel</button>
                    </EditForm>
                </AddSection>
            }
        </section>

        <section class="card">
            <h2><Icon Name="trophy" /> Mecze i turnieje</h2>
            @if (p.Matches.Count == 0) { <p class="muted">Brak meczów.</p> }
            <ul class="list">
                @foreach (var m in p.Matches)
                {
                    <li>
                        <span class="result @(m.Won ? "W" : "L")">@(m.Won ? "W" : "P")</span>
                        <span class="grow">
                            @(m.Opponent is null ? "Mecz" : $"vs {m.Opponent}")
                            @if (m.Score is not null) { <text>&nbsp;</text><strong>@m.Score</strong> }
                            <span class="muted small block">@m.Date.ToString("dd.MM.yyyy")@(m.Tournament is null ? "" : $" · {m.Tournament}")</span>
                            @if (m.Notes is not null) { <span class="small block pre">@m.Notes</span> }
                        </span>
                        @if (IsCoach) { <button class="icon-btn" aria-label="Usuń mecz" @onclick="() => DeleteAsync(Kind.Matches, m.Id)"><Icon Name="x" Size="18" /></button> }
                    </li>
                }
            </ul>
            @if (IsCoach)
            {
                <AddSection Title="Nowy mecz" @bind-Open="_open[Kind.Matches]">
                    <EditForm Model="_match" OnValidSubmit="() => AddAsync(Kind.Matches, _match)" class="stack" FormName="match">
                        <DataAnnotationsValidator />
                        <div class="row2">
                            <label>Data <InputDate @bind-Value="_match.Date" /></label>
                            <label>
                                Wynik
                                <InputSelect @bind-Value="_match.Won">
                                    <option value="true">Wygrana</option>
                                    <option value="false">Przegrana</option>
                                </InputSelect>
                            </label>
                        </div>
                        <label>Turniej <InputText @bind-Value="_match.Tournament" maxlength="200" /></label>
                        <div class="row2">
                            <label>Przeciwnik <InputText @bind-Value="_match.Opponent" maxlength="200" /></label>
                            <label>Wynik w setach <InputText @bind-Value="_match.Score" maxlength="60" placeholder="6:4 3:6 10:8" /></label>
                        </div>
                        <label>Uwagi <InputTextArea @bind-Value="_match.Notes" rows="2" maxlength="2000" /></label>
                        <button class="btn primary">Dodaj mecz</button>
                    </EditForm>
                </AddSection>
            }
        </section>
    </div>

    <section class="card">
        <h2><Icon Name="clipboard" /> Dziennik treningów</h2>
        @if (p.Trainings.Count == 0) { <p class="muted">Brak wpisów.</p> }
        <ul class="list">
            @foreach (var t in p.Trainings)
            {
                <li>
                    <span class="date-pill">@t.Date.ToString("dd.MM.yyyy")</span>
                    <span class="grow">
                        <strong>@t.Topic</strong>@if (t.DurationMin is { } min) { <span class="muted small"> · @min min</span> }
                        @if (t.HasScores)
                        {
                            <span class="ratings">
                                @foreach (var skill in Skills.All)
                                {
                                    @if (t.Scores.GetValueOrDefault(skill.Key) is { } score)
                                    {
                                        <span class="rating k-@skill.Key" title="@skill.Label"><span class="dot"></span>@skill.Label <strong>@score</strong></span>
                                    }
                                }
                            </span>
                        }
                        @if (t.Notes is not null) { <span class="small block pre">@t.Notes</span> }
                    </span>
                    @if (IsCoach) { <button class="icon-btn" aria-label="Usuń trening" @onclick="() => DeleteAsync(Kind.Trainings, t.Id)"><Icon Name="x" Size="18" /></button> }
                </li>
            }
        </ul>
        @if (IsCoach)
        {
            <AddSection Title="Nowy trening" @bind-Open="_open[Kind.Trainings]">
                <EditForm Model="_training" OnValidSubmit="() => AddAsync(Kind.Trainings, _training)" class="stack" FormName="training">
                    <DataAnnotationsValidator />
                    <div class="row2">
                        <label>Data <InputDate @bind-Value="_training.Date" /></label>
                        <label>Czas (min) <InputNumber @bind-Value="_training.DurationMin" min="1" max="600" /></label>
                    </div>
                    <label>Temat <InputText @bind-Value="_training.Topic" maxlength="200" placeholder="np. Serwis – rzut piłki, trafienie w pole" /></label>
                    <ValidationMessage For="() => _training.Topic" />
                    <fieldset>
                        <legend>Ocena elementów (1–6, 6 = najlepiej)</legend>
                        <div class="score-grid">
                            @foreach (var box in _scores)
                            {
                                <label>
                                    @box.Label
                                    <InputSelect @bind-Value="box.Value">
                                        <option value="">—</option>
                                        @for (var n = Skills.Min; n <= Skills.Max; n++) { <option value="@n">@n</option> }
                                    </InputSelect>
                                </label>
                            }
                        </div>
                        <p class="muted small">Zostaw „—”, jeśli element nie był oceniany na tym treningu.</p>
                    </fieldset>
                    <ValidationSummary />
                    <label>Notatki <InputTextArea @bind-Value="_training.Notes" rows="2" maxlength="2000" /></label>
                    <button class="btn primary">Dodaj trening</button>
                </EditForm>
            </AddSection>
        }
    </section>

    @if (p.Parents is { } parents)
    {
        <section class="card">
            <h2><Icon Name="users" /> Rodzice z dostępem <span class="badge">tylko trener</span></h2>
            <p class="muted small">Tylko te osoby (oraz trenerzy) widzą profil tego zawodnika.</p>
            <ul class="list">
                @if (parents.Count == 0) { <li class="muted">Nikt nie ma jeszcze dostępu.</li> }
                @foreach (var pr in parents)
                {
                    <li>
                        <span class="grow"><strong>@pr.Name</strong> <span class="muted small">@pr.Email</span></span>
                        <button class="btn small" @onclick="() => UnlinkAsync(pr)">Odłącz</button>
                    </li>
                }
            </ul>
            @{ var available = _allParents.Where(a => parents.All(x => x.Id != a.Id)).ToList(); }
            @if (available.Count > 0)
            {
                <div class="row-form">
                    <select @bind="_parentToLink">
                        <option value="0">Wybierz rodzica…</option>
                        @foreach (var a in available) { <option value="@a.Id">@a.Name (@a.Email)</option> }
                    </select>
                    <button class="btn" disabled="@(_parentToLink == 0)" @onclick="LinkAsync">Przypisz</button>
                </div>
            }
            <p class="small"><a href="parents">Utwórz nowe konto rodzica →</a></p>
        </section>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private static class Kind
    {
        public const string Trainings = "trainings", Matches = "matches", Goals = "goals";
    }

    // Binds one select to one entry of TrainingForm.Scores (inputs can't bind to a dictionary indexer directly).
    private sealed class ScoreBox(Skill skill, Dictionary<string, int?> scores)
    {
        public string Label => skill.Label;
        public int? Value { get => scores[skill.Key]; set => scores[skill.Key] = value; }
    }

    private PlayerDetail? _p;
    private IReadOnlyList<string>? _loadErrors;
    private List<ParentDto> _allParents = [];
    private int _parentToLink;
    private string? _focus; // element shown on the main chart; null = all

    private IReadOnlyList<Skill>? FocusSkills => _focus is null ? null : Skills.All.Where(s => s.Key == _focus).ToList();

    // Average of every rating of one element, and how much it changed since its first rating.
    private static (double? Avg, int? Delta) Stats(IReadOnlyList<TrainingDto> newestFirst, string key)
    {
        var values = newestFirst.Select(t => t.Scores.GetValueOrDefault(key)).Where(v => v.HasValue).Select(v => v!.Value).ToList();
        if (values.Count == 0) return (null, null);
        return (values.Average(), values.Count >= 2 ? values[0] - values[^1] : null);
    }

    private readonly Dictionary<string, bool> _open = new()
    {
        [Kind.Trainings] = false, [Kind.Matches] = false, [Kind.Goals] = false,
    };
    private List<ScoreBox> _scores = [];
    private TrainingForm _training = new();
    private MatchForm _match = new();
    private GoalForm _goal = new();

    private bool IsCoach => Auth.User?.IsCoach == true;

    protected override async Task OnParametersSetAsync()
    {
        await Auth.GetAuthenticationStateAsync();
        await LoadAsync();
        if (IsCoach && _p is not null)
        {
            var parents = await Api.Parents();
            _allParents = parents.Value ?? [];
        }
    }

    private async Task LoadAsync()
    {
        var res = await Api.Player(Id);
        _loadErrors = res.Ok ? null : res.Errors;
        _p = res.Value;
        if (_scores.Count == 0) ResetTrainingForm();
    }

    private void ResetTrainingForm()
    {
        _training = new TrainingForm();
        _scores = Skills.All.Select(s => new ScoreBox(s, _training.Scores)).ToList();
    }

    private async Task AddAsync(string kind, object form)
    {
        var res = await Api.AddRecord(Id, kind, form);
        if (!res.Ok)
        {
            Toasts.Errors(res.Errors);
            return;
        }
        _open[kind] = false;
        switch (kind)
        {
            case Kind.Trainings: ResetTrainingForm(); break;
            case Kind.Matches: _match = new(); break;
            case Kind.Goals: _goal = new(); break;
        }
        Toasts.Success(kind switch
        {
            Kind.Trainings => "Dodano trening.",
            Kind.Matches => "Dodano mecz.",
            _ => "Dodano cel.",
        });
        await LoadAsync();
    }

    private async Task DeleteAsync(string kind, int recordId)
    {
        if (!await Js.ConfirmAsync("Usunąć ten wpis?")) return;
        var res = await Api.DeleteRecord(Id, kind, recordId);
        if (res.Ok) Toasts.Success("Usunięto wpis."); else Toasts.Errors(res.Errors);
        await LoadAsync();
    }

    private async Task ToggleGoalAsync(int goalId)
    {
        var res = await Api.ToggleGoal(Id, goalId);
        if (!res.Ok) Toasts.Errors(res.Errors);
        await LoadAsync();
    }

    private async Task LinkAsync()
    {
        var res = await Api.LinkParent(Id, _parentToLink);
        if (res.Ok) Toasts.Success("Przypisano rodzica."); else Toasts.Errors(res.Errors);
        _parentToLink = 0;
        await LoadAsync();
    }

    private async Task UnlinkAsync(ParentRef parent)
    {
        if (!await Js.ConfirmAsync($"Odebrać dostęp: {parent.Name}?")) return;
        var res = await Api.UnlinkParent(Id, parent.Id);
        if (res.Ok) Toasts.Success("Odłączono rodzica od zawodnika."); else Toasts.Errors(res.Errors);
        await LoadAsync();
    }
}
