@* Collapsible "+ add" panel under a list; the parent controls Open so it can close it after saving. *@
<div class="add">
    <button type="button" class="add-toggle" aria-expanded="@Open" @onclick="ToggleAsync">
        @(Open ? "− " : "+ ")@Title
    </button>
    @if (Open)
    {
        <div class="add-body">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task ToggleAsync() => OpenChanged.InvokeAsync(!Open);
}
