@* Line chart of the average assessment score over time (0–10 scale), drawn as inline SVG. *@
@if (_points.Count >= 2)
{
    <svg class="chart" viewBox="0 0 @W @H" role="img" aria-label="Wykres średniej oceny w czasie">
        @for (var v = 0; v <= 10; v += 2)
        {
            @* <g> wrappers: a bare <text> inside a code block is Razor's own tag. *@
            <g>
                <line class="gridline" x1="@L" x2="@(W - R)" y1="@F(Y(v))" y2="@F(Y(v))" />
                <text class="axis" x="@(L - 8)" y="@F(Y(v) + 4)" text-anchor="end">@v</text>
            </g>
        }
        @for (var i = 0; i < _points.Count; i++)
        {
            if (i % _labelStep == 0 || i == _points.Count - 1)
            {
                <g><text class="axis" x="@F(X(i))" y="@(H - 8)" text-anchor="middle">@_points[i].Date.ToString("dd.MM")</text></g>
            }
        }
        <polyline class="s-avg" points="@string.Join(" ", _points.Select((p, i) => $"{F(X(i))},{F(Y(p.Value))}"))" />
        @for (var i = 0; i < _points.Count; i++)
        {
            <circle class="s-avg" cx="@F(X(i))" cy="@F(Y(_points[i].Value))" r="3.5">
                <title>@_points[i].Date.ToString("dd.MM.yyyy"): @_points[i].Value.ToString("0.0")</title>
            </circle>
        }
    </svg>
}

@code {
    private const double W = 640, H = 260, L = 34, R = 30, T = 14, B = 40;

    /// <summary>Assessments in any order; plotted oldest → newest.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<AssessmentDto> Assessments { get; set; } = [];

    private List<(DateOnly Date, double Value)> _points = [];
    private int _labelStep = 1;

    protected override void OnParametersSet()
    {
        _points = Assessments.Where(a => a.Average.HasValue).OrderBy(a => a.Date).ThenBy(a => a.Id)
            .Select(a => (a.Date, a.Average!.Value)).ToList();
        _labelStep = Math.Max(1, (int)Math.Ceiling(_points.Count / 8.0));
    }

    private double X(int i) => L + i * (W - L - R) / (_points.Count - 1);
    private static double Y(double v) => T + (10 - v) * (H - T - B) / 10;
    private static string F(double d) => d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
