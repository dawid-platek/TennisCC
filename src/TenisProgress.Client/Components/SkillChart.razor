@* Line chart of training ratings (1–6) over time, one line per skill, drawn as inline SVG. *@
@if (_points.Count >= 2)
{
    <svg class="chart @(Compact ? "compact" : "")" viewBox="0 0 @F(W) @F(H)" role="img" aria-label="@Label">
        @for (var v = Skills.Min; v <= Skills.Max; v++)
        {
            @* <g> wrappers: a bare <text> inside a code block is Razor's own tag. *@
            <g>
                <line class="gridline" x1="@F(L)" x2="@F(W - R)" y1="@F(Y(v))" y2="@F(Y(v))" />
                <text class="axis" x="@F(L - 8)" y="@F(Y(v) + 4)" text-anchor="end">@v</text>
            </g>
        }
        @for (var i = 0; i < _points.Count; i++)
        {
            if (i % _labelStep == 0 || i == _points.Count - 1)
            {
                <g><text class="axis" x="@F(X(i))" y="@F(H - 8)" text-anchor="middle">@_points[i].Date.ToString("dd.MM")</text></g>
            }
        }
        @foreach (var skill in Shown)
        {
            var coords = _points.Select((p, i) => (p, i)).Where(t => t.p.Scores.GetValueOrDefault(skill.Key).HasValue).ToList();
            if (coords.Count == 0) continue;
            var pts = coords.Select(t => (x: X(t.i), y: Y(t.p.Scores[skill.Key]!.Value))).ToList();
            var line = Smooth(pts);
            @if (Compact)
            {
                <path class="area k-@skill.Key" d="@line L @F(pts[^1].x),@F(Y(Skills.Min)) L @F(pts[0].x),@F(Y(Skills.Min)) Z" />
            }
            <path class="line k-@skill.Key" d="@line" />
            @foreach (var (p, i) in coords)
            {
                <circle class="k-@skill.Key" cx="@F(X(i))" cy="@F(Y(p.Scores[skill.Key]!.Value))" r="3.5">
                    <title>@skill.Label, @p.Date.ToString("dd.MM.yyyy"): @p.Scores[skill.Key]</title>
                </circle>
            }
        }
    </svg>
}

@code {
    private const double T = 14;
    private double R => Compact ? 14 : 30;
    private double W => Compact ? 320 : 640;
    private double H => Compact ? 150 : 260;
    private double L => 26;
    private double B => Compact ? 30 : 40;

    /// <summary>Trainings in any order; only rated ones are plotted, oldest → newest.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TrainingDto> Trainings { get; set; } = [];

    /// <summary>Which elements to draw (all five by default).</summary>
    [Parameter] public IReadOnlyList<Skill>? Only { get; set; }

    /// <summary>Small version for a single element.</summary>
    [Parameter] public bool Compact { get; set; }

    [Parameter] public string Label { get; set; } = "Wykres postępów";

    private IReadOnlyList<Skill> Shown => Only ?? Skills.All;

    private List<TrainingDto> _points = [];
    private int _labelStep = 1;

    protected override void OnParametersSet()
    {
        _points = Trainings
            .Where(t => Shown.Any(s => t.Scores.GetValueOrDefault(s.Key).HasValue))
            .OrderBy(t => t.Date).ThenBy(t => t.Id).ToList();
        _labelStep = Math.Max(1, (int)Math.Ceiling(_points.Count / (Compact ? 4.0 : 8.0)));
    }

    private double X(int i) => L + i * (W - L - R) / (_points.Count - 1);
    private double Y(double v) => T + (Skills.Max - v) * (H - T - B) / (Skills.Max - Skills.Min);
    // Smooth curve through the points that never overshoots them (monotone cubic), so a line
    // can't dip below 1 or rise above 6 between two ratings.
    private static string Smooth(IReadOnlyList<(double x, double y)> p)
    {
        var n = p.Count;
        var start = $"M{F(p[0].x)},{F(p[0].y)}";
        if (n < 2) return start;

        var h = new double[n - 1];
        var d = new double[n - 1];
        for (var i = 0; i < n - 1; i++)
        {
            h[i] = p[i + 1].x - p[i].x;
            d[i] = h[i] == 0 ? 0 : (p[i + 1].y - p[i].y) / h[i];
        }
        var m = new double[n];
        m[0] = d[0];
        m[n - 1] = d[n - 2];
        for (var i = 1; i < n - 1; i++) m[i] = d[i - 1] * d[i] <= 0 ? 0 : (d[i - 1] + d[i]) / 2;
        for (var i = 0; i < n - 1; i++)
        {
            if (d[i] == 0) { m[i] = 0; m[i + 1] = 0; continue; }
            double a = m[i] / d[i], b = m[i + 1] / d[i], sq = a * a + b * b;
            if (sq > 9)
            {
                var t = 3 / Math.Sqrt(sq);
                m[i] = t * a * d[i];
                m[i + 1] = t * b * d[i];
            }
        }

        var sb = new System.Text.StringBuilder(start);
        for (var i = 0; i < n - 1; i++)
        {
            var dx = h[i] / 3;
            sb.Append($" C{F(p[i].x + dx)},{F(p[i].y + m[i] * dx)} {F(p[i + 1].x - dx)},{F(p[i + 1].y - m[i + 1] * dx)} {F(p[i + 1].x)},{F(p[i + 1].y)}");
        }
        return sb.ToString();
    }

    private static string F(double d) => d.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
