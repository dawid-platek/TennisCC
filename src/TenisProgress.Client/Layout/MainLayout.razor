@inherits LayoutComponentBase
@implements IDisposable
@inject Api Api
@inject AppAuthStateProvider Auth
@inject Toasts Toasts
@inject NavigationManager Nav

<header class="topbar">
    <a class="brand" href=""><span class="ball" aria-hidden="true"></span><span class="brand-name">Tenis <b>Progress</b></span></a>
    <AuthorizeView>
        <Authorized>
            <nav class="nav-desktop" aria-label="Główna nawigacja">
                <NavItems IsCoach="@(Auth.User?.IsCoach == true)" />
            </nav>
            <div class="user">
                <NavLink class="user-chip" href="account" title="Moje konto">
                    <span class="avatar sm">@Initials(context.User.Identity?.Name)</span>
                    <span class="user-name">@context.User.Identity?.Name</span>
                </NavLink>
                <button class="icon-link" @onclick="LogoutAsync" title="Wyloguj" aria-label="Wyloguj"><Icon Name="logout" /></button>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<AuthorizeView>
    <Authorized>
        <nav class="tabbar" aria-label="Nawigacja mobilna">
            <NavItems IsCoach="@(Auth.User?.IsCoach == true)" ShowAccount="true" />
        </nav>
    </Authorized>
</AuthorizeView>

@if (Toasts.Current is { } toast)
{
    <div class="toast @(toast.Kind == ToastKind.Success ? "success" : "error")" role="status">
        <Icon Name="@(toast.Kind == ToastKind.Success ? "check" : "alert")" />
        <span class="grow">@toast.Text</span>
        <button class="icon-btn" aria-label="Zamknij" @onclick="Toasts.Clear"><Icon Name="x" Size="18" /></button>
    </div>
}

<main>
    <div id="install" class="install" hidden>
        <span class="install-text"></span>
        <button type="button" class="btn small primary install-btn" hidden>Zainstaluj</button>
        <button type="button" class="icon-btn install-close" aria-label="Zamknij"><Icon Name="x" Size="18" /></button>
    </div>

    @if (Auth.IsOffline)
    {
        <section class="card narrow">
            <h1>Brak połączenia</h1>
            <p>Nie można połączyć się z serwerem. Sprawdź internet i spróbuj ponownie.</p>
            <button class="btn primary" @onclick="RetryAsync">Spróbuj ponownie</button>
        </section>
    }
    else
    {
        <ErrorBoundary @ref="_boundary">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <section class="card narrow">
                    <h1>Coś poszło nie tak</h1>
                    <p>Wystąpił nieoczekiwany błąd aplikacji.</p>
                    <button class="btn" @onclick="() => _boundary?.Recover()">Spróbuj ponownie</button>
                </section>
            </ErrorContent>
        </ErrorBoundary>
    }
</main>

@code {
    private ErrorBoundary? _boundary;

    protected override void OnInitialized()
    {
        Toasts.Changed += OnToastsChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnToastsChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        Toasts.OnNavigated(Toasts.PathOf(Nav, e.Location));

    protected override void OnParametersSet() => _boundary?.Recover();

    private static string Initials(string? name) =>
        string.Concat((name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    private async Task RetryAsync()
    {
        Auth.Retry();
        await Auth.GetAuthenticationStateAsync();
        if (!Auth.IsOffline) Nav.NavigateTo(Nav.Uri, forceLoad: false, replace: true);
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await Api.Logout();
        Toasts.Clear();
        Auth.SignedOut();
        Nav.NavigateTo("login");
    }

    public void Dispose()
    {
        Toasts.Changed -= OnToastsChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
